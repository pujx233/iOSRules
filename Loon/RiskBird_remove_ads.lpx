#!name=风鸟去广告
#!desc=移除首页信息流和轮播图
#!openUrl=https://apps.apple.com/app/id1528682937
#!author=可莉🅥
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/RiskBird_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/RiskBird.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList/i then reject_dict(200)

request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend/i then script("https://raw.githubusercontent.com/pujx233/iOSRules/main/Script/Kelee/RiskBird_remove_ads.js") with tag="移除推荐老板", requires_body=true

[MitM]
hostname=m.riskbird.com