#!name=创维智慧云去广告
#!desc=移除开屏广告、横幅广告。
#!openUrl=https://apps.apple.com/app/id1459081477
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/SkyworthDigitalPicamera_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/SkyworthDigitalPicamera.png
#!date=2026-11-21

[Rewrite]
request if ${url} ~= /^https:\/\/app\.skyworthdigitaliot\.com\/skyworthOperation\/v\d\/appOperation\/allBannerConfig\?/i then reject_dict(200)

[MitM]
hostname=app.skyworthdigitaliot.com