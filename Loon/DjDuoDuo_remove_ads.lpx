[Script]
response if ${url} ~= /^https:\/\/api\.dianyinduoduo\.com\/v4\/config\.php\?/i then script("https://raw.githubusercontent.com/pujx233/iOSRules/main/Script/Kelee/DjDuoDuo_remove_ads.js") with tag="去广告", requires_body=true

[MitM]
hostname=api.dianyinduoduo.com