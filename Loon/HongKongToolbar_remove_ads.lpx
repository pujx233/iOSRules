#!name=Hong Kong Toolbar去广告
#!desc=移除开屏互动广告、直播前贴片广告及视频广告
#!openUrl=https://apps.apple.com/app/id735754930
#!author=C.Hiang
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/HongKongToolbar_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/HongKongToolbar.png
#!date=2026-11-21

[Rule]
URL-REGEX, "^https:\/\/a\.881903\.com\/live\/preroll\/.*\/.*", REJECT-DROP
URL-REGEX, "^https:\/\/a\.881903\.com\/v\d\/app\/game\/.*", REJECT-DROP

[MitM]
hostname=a.881903.com