#!name=Dlabel云标签去广告
#!desc=移除开屏广告及首页横幅。
#!openUrl=https://apps.apple.com/app/id1397719437
#!author=可莉🅥
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/Dlabel_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/Dlabel.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/dlabel\.ctaiot\.com\/api\/spreadstart\/list\.json\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/dlabel\.ctaiot\.com\/api\/spread\/journey\/select\.json\?/i then reject_dict(200)

[MitM]
hostname=dlabel.ctaiot.com