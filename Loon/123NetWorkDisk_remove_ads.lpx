#!name=123云盘去广告
#!desc=移除开屏广告、应用内横幅广告。
#!openUrl=https://apps.apple.com/app/id1597682672
#!author=可莉🅥
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/123NetWorkDisk_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/123NetWorkDisk.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/www\.123pan\.com\/api\/config\/get/i then reject_dict(200)

[MitM]
hostname=www.123pan.com