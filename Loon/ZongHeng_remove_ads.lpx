#!name=纵横小说去广告
#!desc=移除纵横小说开屏广告和弹窗
#!openUrl=https://apps.apple.com/app/id433125283
#!author=可莉🅥
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/ZongHeng_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/ZongHeng.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/api1\.zongheng\.com\/iosapi\/system\/startup$/i then reject(404)
request if ${url} ~= /^https:\/\/api2\.zongheng\.com\/api\/giftBag\/bindingBag$/i then reject_dict(200)

[MitM]
hostname=api?.zongheng.com