#!name=航旅纵横去广告
#!desc=过滤航旅纵横广告
#!openUrl=https://apps.apple.com/app/id480161784
#!author=佚名
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/Umetrip_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Umetrip.png
#!date=2026-10-02 13:57:49

[Rule]
URL-REGEX, "^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native", REJECT

[Script]
response if ${url} ~= /^http?:\/\/(114\.115\.217\.129)|(home\.umetrip\.com)\/gateway\/api\/umetrip\/native$/i then script("https://raw.githubusercontent.com/pujx233/iOSRules/main/Script/Kelee/Umetrip_remove_ads.js") with tag="移除首页广告"

[MitM]
hostname=114.115.217.129, home.umetrip.com