#!name=Fileball网盘挂载
#!desc=支持挂载阿里云盘、夸克网盘和PikPak网盘，点击下方署名查看使用方法。
#!openUrl=https://apps.apple.com/app/id1558391784
#!author=小白脸
#!tag=功能增强
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/Fileball_mount.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/Fileball.png
#!date=2026-10-02 13:57:49

[Script]
request if ${url} ~= /^http:\/\/(aliyun|quark|pikpak)\.example\.com/i then script("https://raw.githubusercontent.com/pujx233/iOSRules/main/Script/Kelee/Fileball_mount.js") with tag="三合一网盘挂载", requires_body=true

[MitM]
hostname=aliyun.example.com, quark.example.com, pikpak.example.com,