#!name=有道云笔记去广告
#!desc=移除开屏广告、弹窗广告及横幅广告。
#!openUrl=https://apps.apple.com/app/id353115739
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/YoudaoNote_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/YoudaoNote.png
#!date=2026-11-21

[Rewrite]
request if ${url} ~= /^https:\/\/silk\.lx\.netease\.com\/api\/open\/advertOpen\//i then reject_dict(200)

[MitM]
hostname=silk.lx.netease.com