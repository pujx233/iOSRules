#!name=顺丰速运去广告
#!desc=移除开屏广告、首页下拉抽屉、首页推广、应用内悬浮窗、横幅广告，移除主题，精简我的页面。
#!openUrl=https://apps.apple.com/app/id899529698
#!author=可莉🅥
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/pujx233/iOSRules/blob/main/Loon/SF-Express_remove_ads.lpx
#!icon=https://raw.githubusercontent.com/pujx233/iOSRules/main/Icon/SF-Express.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberGoods\/pointMallService\/goodsList$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/ucmp(-static)?\.sf-express\.com\/proxy\/ccspBase\/module-config\/(login\/)?query\?/i then response.body.mock_file("json", "https://raw.githubusercontent.com/pujx233/iOSRules/main/Script/Mock/SF-Express.json", 200)

response if ${url} ~= /^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appHomeConfig\/query$/i then response.json.jq(".obj |= map(select(.position != 2))")

[MitM]
hostname=ccsp-egmas.sf-express.com, ucmp.sf-express.com, ucmp-static.sf-express.com
